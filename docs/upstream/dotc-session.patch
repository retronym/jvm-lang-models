+    println(s"[cancel-inside-a-statement] inside giant of object 300 (replaced, resumed): runId=$runId4 typedTopLevelCount=$typed4 skipped=$skipped4 (${obtained4.linesIterator.size} items)")
+    assert(obtained4.linesIterator.exists(_.startsWith("filter")), s"expected filter among the completions, got: $obtained4")
+    assertEquals(runId1, runId4, "the resume after the abort must continue the same run")
+    assertEquals(typed1 + 2, typed4, "object 300 is typed")
+    assertNoDiff(expectedAt(300), complete(bigSource("cancel", 300, heavy = heavy)))
+
+  @Test def `cancel-inside-a-member` =
+    val heavy = Set(300)
+    // `val r` of the heavy object: its methods, `giant` included, are skipped
+    assertNoDiff(expectedAt(300), complete(bigSource("cancel-member", 300, heavy = heavy)))
+    val (runId1, typed1, skipped1) = state()
+    println(s"[cancel-inside-a-member] after `val r` of object 300: runId=$runId1 typedTopLevelCount=$typed1 skipped=$skipped1")
+    val (code, offset) = params(bigSource("cancel-member", 300, inGiant = true, heavy = heavy))
+    // Cancel at the first typer checkpoint reached while typing `giant` alone
+    val (thrown, polls) = cancelAtCheckpoint(1)(_.runUpTo(uri, SourceFile.virtual(uri, code), Span(offset)))
+    val (runId2, typed2, skipped2) = state()
+    println(s"[cancel-inside-a-member] thrown=$thrown polls=$polls; after the abort: runId=$runId2 typedTopLevelCount=$typed2 skipped=$skipped2")
+    assert(thrown, "the resume must be aborted with CancelledCompilation")
+    assertEquals(runId1, runId2, "the aborted resume must keep the run")
+    assertEquals(skipped1, skipped2, "the aborted member is replaced and skipped again")
+    val obtained3 = complete(bigSource("cancel-member", 300, inGiant = true, heavy = heavy))
+    val (runId3, typed3, skipped3) = state()
+    println(s"[cancel-inside-a-member] inside giant again: runId=$runId3 typedTopLevelCount=$typed3 skipped=$skipped3 (${obtained3.linesIterator.size} items)")
+    assert(obtained3.linesIterator.exists(_.startsWith("filter")), s"expected filter among the completions, got: $obtained3")
+    assertEquals(runId1, runId3, "after an abort inside a member, the same run serves the next request")
+    assertEquals(skipped2 - 1, skipped3, "the member is typed")
diff --git a/compiler/src/dotty/tools/dotc/typer/Targeting.scala b/compiler/src/dotty/tools/dotc/typer/Targeting.scala
new file mode 100644
index 0000000000..3244296b9e
--- /dev/null
+++ b/compiler/src/dotty/tools/dotc/typer/Targeting.scala
@@ -0,0 +1,164 @@
+package dotty.tools
+package dotc
+package typer
+
+import core.*
+import Contexts.*, Symbols.*, Names.*, NameOps.*, Flags.*, Types.*
+import ast.{tpd, untpd}
+import util.Spans.*
+import collection.mutable
+
+/** Targeted typing of one statement list (interactive mode, see
+ *  `Run.typingTarget` and `InteractiveDriver.runUpTo`).
+ *
+ *  Of the statements of a package, a template or a block on the path to the
+ *  target only the statement whose span contains the target is typed (a class
+ *  and its synthetic companion share the span, so both are); `skip` records
+ *  the others on the run, with the context they would have been typed in, for
+ *  the driver to type later in the same run. The rules, in the order `skip`
+ *  applies them:
+ *
+ *   - always typed: imports and exports shape later contexts; package clauses
+ *     are containers; zero-extent and synthetic definitions are what the next
+ *     statement is built from.
+ *   - source check: a span is an offset in its own source; an inlined macro
+ *     body carries the macro's. (`Targeting.of`)
+ *   - typed whole: a class or block reached other than along the path (typed
+ *     ahead by a completer, a refinement's class) is typed whole, because its
+ *     typed form is cached and reused. (The marking sites in `Typer`)
+ *   - inline: never inside an inline method: its body is registered whole.
+ *   - needed-before: the statements before the target's that it names are
+ *     typed in order, so a chain of locals is not typed ahead recursively.
+ *   - next-after: a target between statements types the next one (scaladoc
+ *     completion needs the documented def).
+ *   - the expansion of a kept definition that holds the target or comes next
+ *     after it is typed whole (an `extension` block expands into methods whose
+ *     own spans need not contain a target in the block's comment).
+ *   - block stubs: a skipped local leaves a stub so a scope rebuilt from the
+ *     typed tree sees it.
+ *
+ *  Design and findings: docs §3, I19-I28.
+ */
+private[typer] final class Targeting(
+    typer: Typer, stats: List[untpd.Tree], exprOwner: Symbol, inBlock: Boolean, buf: mutable.ListBuffer[tpd.Tree])(using Context):
+  import Targeting.*
+
+  private val run = ctx.run.nn
+  private val target = run.typingTarget
+
+  private val nextAfterTarget: untpd.Tree | Null =
+    if !stats.exists(_.span.contains(target)) then
+      stats.find(s => s.span.exists && s.span.start >= target.end).orNull
+    else null
+
+  /** The span of a kept definition whose expansion is typed whole */
+  private var forcedSpan: Span = NoSpan
+
+  private val neededInBlock: Set[untpd.Tree] =
+    if !inBlock then Set.empty
+    else
+      val targetIdx = stats.indexWhere(_.span.contains(target))
+      if targetIdx < 0 then Set.empty
+      else
+        val before = stats.take(targetIdx).toArray
+        val defined = before.map(definedNames)
+        val needed = new Array[Boolean](before.length)
+        var wanted = usedNames(stats(targetIdx))
+        var i = before.length - 1
+        while i >= 0 do
+          if !needed(i) && defined(i).exists(wanted) then
+            needed(i) = true
+            wanted = wanted ++ usedNames(before(i))
+          i -= 1
+        before.indices.filter(needed).map(before(_)).toSet
+
+  /** Is `stat` skipped? If so it is recorded (and, in a block, leaves a stub
+   *  in `buf`); `ctx` is the context `stat` would be typed in.
+   */
+  def skip(stat: untpd.Tree)(using Context): Boolean =
+    val skipped =
+      stat.span.exists && !stat.span.isZeroExtent
+      && !stat.isInstanceOf[untpd.PackageDef]
+      && !isSyntheticDef(stat) // a desugaring's `$anonfun` in a closure's block, a pattern's temporaries: the statement after them needs them
+      && !neededInBlock.contains(stat)
+      && !stat.span.contains(target)
+      && !(stat eq nextAfterTarget)
+      && !forcedSpan.contains(stat.span)
+    if skipped then
+      if inBlock then buf ++= stubsOf(stat)
+      run.skippedStats += Run.SkippedStat(stat, ctx, exprOwner, inBlock)
+    else stat match
+      case _: untpd.DefTree | _: untpd.ExtMethods =>
+        if stat.span.contains(target) || (stat eq nextAfterTarget) then forcedSpan = stat.span
+      case _ =>
+    skipped
+
+  /** A skipped definition of a block leaves a typed stub in the block: its
+   *  name and symbol, no right-hand side, an untyped type tree, so that a
+   *  scope rebuilt from the typed tree (`Interactive.contextOfPath` enters
+   *  the symbol of every `MemberDef` of a `Block`) sees the local, while its
+   *  info stays lazy until something asks for it. It carries the span of the
+   *  statement, which `InteractiveDriver.spliceAll` matches it by.
+   */
+  private def stubsOf(stat: untpd.Tree)(using Context): List[tpd.Tree] = typer.expanded(stat) match
+    case untpd.Thicket(trees) => trees.flatMap(stubsOf)
+    case t: untpd.DefTree =>
+      t.getAttachment(typer.SymOfTree) match
+        case Some(sym) if sym.exists =>
+          val stub: untpd.Tree = t match
+            case v: untpd.ValDef => untpd.ValDef(v.name, untpd.TypeTree(), untpd.EmptyTree)
+            case d: untpd.DefDef => untpd.DefDef(d.name, Nil, untpd.TypeTree(), untpd.EmptyTree)
+            case td: untpd.TypeDef => untpd.TypeDef(td.name, untpd.EmptyTree)
+            case _ => untpd.EmptyTree
+          if stub.isEmpty then Nil
+          else List(stub.withSpan(t.span).withType(if sym.isType then sym.typeRef else sym.termRef))
+        case _ => Nil
+    case _ => Nil
+
+private[typer] object Targeting:
+
+  /** The targeting of the list `stats` owned by `exprOwner`, if it is subject
+   *  to it: there is a target, `Run.targetNextStats` marked this very list,
+   *  and it is a list of the request's own source. Consumes the mark.
+   */
+  def of(typer: Typer, stats: List[untpd.Tree], exprOwner: Symbol, buf: mutable.ListBuffer[tpd.Tree])(using Context): Targeting | Null =
+    val run = ctx.run.nn
+    if !run.typingTarget.exists then null
+    else
+      val marked = exprOwner eq run.targetedStatsOwner
+      val inBlock = run.targetedStatsInBlock
+      run.targetedStatsOwner = NoSymbol
+      run.targetedStatsInBlock = false
+      if marked && (ctx.compilationUnit ne NoCompilationUnit) && (ctx.source eq ctx.compilationUnit.source)
+      then new Targeting(typer, stats, exprOwner, inBlock, buf)
+      else null
+
+  private def isSyntheticDef(stat: untpd.Tree): Boolean = stat match
+    case mdef: untpd.MemberDef => mdef.mods.is(Synthetic) || mdef.mods.is(Artifact)
+    case _ => false
+
+  /** The names a statement defines, and the names it mentions: a conservative
+   *  footprint (a referenced name that some earlier statement defines makes
+   *  that statement needed).
+   */
+  private def definedNames(t: untpd.Tree)(using Context): Set[Name] = t match
+    case d: untpd.ValDef => Set(d.name)
+    case d: untpd.DefDef => Set(d.name)
+    case d: untpd.TypeDef => Set(d.name)
+    case m: untpd.ModuleDef => Set(m.name, m.name.moduleClassName)
+    case untpd.PatDef(_, pats, _, _) =>
+      val acc = new untpd.UntypedTreeAccumulator[Set[Name]]:
+        def apply(x: Set[Name], t: untpd.Tree)(using Context): Set[Name] = t match
+          case untpd.Bind(n, body) => foldOver(x + n, body)
+          case untpd.Ident(n) => x + n
+          case _ => foldOver(x, t)
+      pats.foldLeft(Set.empty[Name])((x, p) => acc(x, p))
+    case _ => Set.empty
+
+  private def usedNames(t: untpd.Tree)(using Context): Set[Name] =
+    val acc = new untpd.UntypedTreeAccumulator[Set[Name]]:
+      def apply(x: Set[Name], t: untpd.Tree)(using Context): Set[Name] = t match
+        case untpd.Ident(n) => foldOver(x + n, t)
+        case untpd.Select(q, n) => foldOver(x + n, t)
+        case _ => foldOver(x, t)
+    acc(Set.empty, t)
diff --git a/presentation-compiler-testcases/src/tests/macros/Latch.scala b/presentation-compiler-testcases/src/tests/macros/Latch.scala
new file mode 100644
index 0000000000..f6058c2407
--- /dev/null
+++ b/presentation-compiler-testcases/src/tests/macros/Latch.scala
@@ -0,0 +1,21 @@
+package tests.macros
+
+import scala.quoted.*
+
+/** A latch for the typer: `Latch.await` is a transparent inline macro, so it
+ *  is expanded while the enclosing statement is typed, and its expansion
+ *  blocks for as long as the file named by the system property `xray.latch`
+ *  exists. The x-ray server (`dotty.tools.pc.xray.XrayServer`) creates the
+ *  file before a "latched" request and deletes it when the user releases or
+ *  cancels, so that a cancellation lands at a known point of the typing,
+ *  deterministically. Without the property, the macro returns at once.
+ */
+object Latch:
+  transparent inline def await: Int = ${ awaitImpl }
+
+  private def awaitImpl(using Quotes): Expr[Int] =
+    sys.props.get("xray.latch").foreach { path =>
+      val file = new java.io.File(path)
+      while file.exists() do Thread.sleep(10)
+    }
+    '{ 0 }
diff --git a/presentation-compiler/test/dotty/tools/pc/tests/completion/CompletionSoakSuite.scala b/presentation-compiler/test/dotty/tools/pc/tests/completion/CompletionSoakSuite.scala
new file mode 100644
index 0000000000..93e94e4a66
--- /dev/null
+++ b/presentation-compiler/test/dotty/tools/pc/tests/completion/CompletionSoakSuite.scala
@@ -0,0 +1,256 @@
+package dotty.tools.pc.tests.completion
+
+import java.io.File
+import java.net.URI
+
+import scala.collection.mutable
+import scala.language.unsafeNulls
+import scala.util.Random
+
+import dotty.tools.dotc.CompilationUnit.CancelledCompilation
+import dotty.tools.dotc.core.Contexts.*
+import dotty.tools.dotc.core.Phases
+import dotty.tools.dotc.core.Symbols.*
+import dotty.tools.dotc.interactive.{CachedLogicalPackage, Completion, InteractiveDriver}
+import dotty.tools.dotc.util.{SourceFile, SourcePosition}
+import dotty.tools.dotc.util.Spans.Span
+import dotty.tools.pc.base.BasePCSuite
+import dotty.tools.pc.base.TestResources
+
+import org.junit.Test
+
+/** A soak test of the session: a random sequence of targeted requests,
+ *  cancellations and edits on one driver must give, at every completion
+ *  point, the completions a fresh whole-file run gives (`InteractiveDriver.run`,
+ *  everything typed, the batch answer), and must leave no symbol of the file
+ *  marked `Touched`. The cancellations are at a random typer checkpoint, with
+ *  a checkpoint every 16 trees instead of 1024, so they land in arbitrary
+ *  statements, including ones being re-typed after a replacement.
+ */
+class CompletionSoakSuite extends BasePCSuite:
+
+  private val uri = URI.create("file:///Soak.scala")
+
+  private val settings =
+    List("-color:never", "-Ximport-suggestion-timeout", "0",
+      "-classpath", TestResources.classpath.map(_.toString).mkString(File.pathSeparator))
+
+  private def newDriver() = new InteractiveDriver(settings, CachedLogicalPackage.none)
+
+  /** `@@` marks the completion points; the content is the text without them. */
+  private def points(marked: String): (String, List[Int]) =
+    val sb = new StringBuilder
+    val offsets = mutable.ListBuffer.empty[Int]
+    var i = 0
+    while i < marked.length do
+      if marked.startsWith("@@", i) then { offsets += sb.length; i += 2 }
+      else { sb.append(marked.charAt(i)); i += 1 }
+    (sb.toString, offsets.toList)
+
+  /** Objects in the shape of `CompletionSessionSuite`, two points each, and
+   *  one with a method big enough for a checkpoint; `tag` is an edit.
+   */
+  private def objectsFile(tag: String, n: Int = 40): String =
+    val objects = (0 until n).map { i =>
+      val giant =
+        if i == n - 1 then "\n  def giant(xs: List[Int]): Int = {\n" + (0 until 120).map(j => s"    val a$j = xs.map(_ + $j + ${if j == 0 then "0" else s"a${j - 1}"}).fil${if j == 119 then "@@" else ""}ter(_ > $j).sum").mkString("\n") + "\n    a0 + a119\n  }"
+        else ""
+      s"""|object M$i {
+          |  def method$i(xs: List[Int]): Int = xs.map(_ + $i).fil@@ter(_ > $i).sum$giant
+          |  val r = this.meth@@
+          |  val s = M${(i + 7) % n}.meth@@
+          |}""".stripMargin
+    }.mkString("\n")
+    s"// $tag\n$objects\n"
+
+  /** The shapes the wider completion suites tripped on: a sealed hierarchy
+   *  whose children are enum cases elsewhere, a case class with an explicit
+   *  companion `apply`, an extension block, givens, a nested package clause,
+   *  blocks, inferred types across statements.
+   */
+  private def shapesFile(tag: String): String =
+    s"""|// $tag
+        |package shapes {
+        |  object Tags:
+        |    sealed trait Hobby
+        |    sealed trait Chore
+        |  import Tags.*
+        |  enum Activity:
+        |    case Reading(book: String) extends Activity, Hobby
+        |    case Cleaning(time: Int) extends Activity, Chore
+        |    case Singing(song: String) extends Activity, Hobby
+        |  object Wrapper:
+        |    case class TestClass(x: Int)
+        |    object TestClass:
+        |      def apply(x: Int): TestClass = ???
+        |    case class Plain(y: String)
+        |  extension (str: String)
+        |    def shout(times: Int): String = str.toUpperCase * times
+        |    def whisper: String = str.toLowerCase
+        |  trait Show[T]:
+        |    def show(t: T): String
+        |  given Show[Int] with
+        |    def show(t: Int) = t.toString
+        |  given showStr: Show[String] with
+        |    def show(t: String) = t
+        |  object Infer:
+        |    val a = Wrapper.Plain("p")
+        |    val b = a.y@@
+        |    def c = Wrapper.TestClass(1).x@@ + b.len@@
+        |    val d = summon[Show[Int]].sh@@
+        |}
+        |package shapes.use {
+        |  import shapes.*
+        |  import shapes.Tags.*
+        |  object Main {
+        |    def energy(act: Hobby): Int = act match
+        |      case Activity.Rea@@
+        |    val w = Wrapper.TestCl@@
+        |    val n = Wrapper.Test@@
+        |    val sh = "x".sho@@
+        |    val wh = "x".whi@@
+        |    locally {
+        |      val local = Infer.a
+        |      local.y@@
+        |      val t = Infer.d.leng@@
+        |    }
+        |    def giv = summon[Show[String]].sho@@
+        |  }
+        |}
+        |""".stripMargin
+
+  private def labels(driver: InteractiveDriver, source: SourceFile, offset: Int): List[String] =
+    driver.compilationUnits.get(uri) match
+      case Some(unit) =>
+        given Context = driver.currentCtx.fresh.setCompilationUnit(unit).withPhase(Phases.typerPhase(using driver.currentCtx))
+        Completion.completions(SourcePosition(source, Span(offset)))._2.map(c => c.label + " " + c.description).sorted.distinct
+      case None => List("<no unit>")
+
+  /** Symbols of the file still completing, over the packages the file declares. */
+  private def touched(driver: InteractiveDriver): List[String] =
+    given Context = driver.currentCtx
+    val file = driver.openedFiles.get(uri).map(_.file)
+    def ofFile(s: Symbol) = file.exists(f => s.associatedFile != null && s.associatedFile.path == f.path)
+    def walk(pkg: Symbol): List[String] =
+      pkg.info.decls.toList.flatMap { s =>
+        if s.is(dotty.tools.dotc.core.Flags.Package) then walk(s.moduleClass)
+        else if ofFile(s) then
+          val nested = if s.isClass then s.asClass.unforcedDecls.toList else Nil
+          (s :: nested).filter(_.isCompleting).map(_.show)
+        else Nil
+      }
+    walk(defn.RootClass).distinct // the root scope lists a package once per entry (val and class): dedupe
+
+  private def inTyperCheckpoint(): Boolean =
+    Thread.currentThread.getStackTrace.exists(_.getMethodName == "checkCancelledTyping")
+
+  private def soak(name: String, file: String => String, seed: Int, steps: Int): Unit =
+    // A checkpoint every 16 typed trees, so that cancellations land inside
+    // the small statements a targeted run types (1024 by default)
+    val mask = dotty.tools.dotc.Run.typerCheckpointMask
+    dotty.tools.dotc.Run.typerCheckpointMask = 15
+    try soak0(name, file, seed, steps)
+    finally dotty.tools.dotc.Run.typerCheckpointMask = mask
+
+  private def soak0(name: String, file: String => String, seed: Int, steps: Int): Unit =
+    val variants = List("a", "b").map(tag => points(file(tag)))
+    // The oracle: a fresh driver, the whole file typed, the completions at every point
+    val oracle = variants.map { (content, offsets) =>
+      val d = newDriver()
+      val source = SourceFile.virtual(uri, content)
+      d.run(uri, source)
+      offsets.map(o => o -> labels(d, source, o)).toMap
+    }
+    val driver = newDriver()
+    val rng = new Random(seed)
+    var variant = 0
+    var runId = -1
+    var cancelled = 0
+    var fresh = 0
+    var polls = 0
+    val log = mutable.ListBuffer.empty[String]
+    def check(step: Int, what: String, offset: Int): Unit =
+      val (content, _) = variants(variant)
+      val source = SourceFile.virtual(uri, content)
+      val diags = driver.runUpTo(uri, source, Span(offset))
+      val obtained = labels(driver, source, offset)
+      def treeAt: String =
+        driver.compilationUnits.get(uri).map { unit =>
+          given Context = driver.currentCtx.fresh.setCompilationUnit(unit)
+          val path = dotty.tools.dotc.interactive.Interactive.pathTo(unit.tpdTree, Span(offset))
+          path.take(3).map(t => s"${t.getClass.getSimpleName}[${t.span.start},${t.span.end}) ${t.show.take(60).replace('\n', ' ')} : ${if t.hasType then t.tpe.show.take(80) else "<untyped>"}").mkString(" <- ")
+        }.getOrElse("<no unit>")
+      val expected = oracle(variant)(offset)
+      val id = driver.runIdOf(uri)
+      if id != runId then { fresh += 1; runId = id }
+      val skippedText = driver.untypedSpans(uri).map(sp => content.substring(sp.start, math.min(sp.end, sp.start + 18)).replace('\n', ' ')).mkString("[", " | ", "]")
+      log += s"$step $what@$offset run=$id typed=${driver.typedTopLevelCount(uri)} skipped=${driver.untypedSpans(uri).size} $skippedText tainted=${driver.isTainted(uri)}"
+      if expected != obtained then
+        println(s"[soak $name seed=$seed step $step] MISMATCH at $offset: tree path: $treeAt; diagnostics of the request: ${diags.map(d => s"${d.pos.line + 1}: ${d.msg.message.take(100)}")}")
+        // the givens of the file's packages, as the driver's context sees them
+        locally {
+          given Context = driver.currentCtx
+          val file = driver.openedFiles.get(uri).map(_.file)
+          def walk(pkg: Symbol): List[Symbol] = pkg.info.decls.toList.flatMap { s =>
+            if s.is(dotty.tools.dotc.core.Flags.Package) then walk(s.moduleClass)
+            else if file.exists(f => s.associatedFile != null && s.associatedFile.path == f.path) then List(s) else Nil }
+          val syms = walk(defn.RootClass).distinct
+          println(s"[soak] symbols of the file: " + syms.map(sy => s"${sy.name}(${sy.flagsString.take(30)}; completed=${sy.isCompleted} completing=${sy.isCompleting}${if sy.isCompleted then " info=" + sy.info.show.take(40) else ""})").mkString(", "))
+          for pkgObj <- syms.filter(sy => sy.isClass && sy.name.toString.endsWith("$package$")) do
+            val members = pkgObj.asClass.unforcedDecls.toList
+            println(s"[soak] members of ${pkgObj.name}: " + members.map(m => s"${m.name}(${m.flagsString.take(40)}; completed=${m.isCompleted} completing=${m.isCompleting} info=${if m.isCompleted then m.info.show.take(60) else m.infoOrCompleter.getClass.getSimpleName})").mkString(", "))
+          val dupes = syms.groupBy(_.name).filter(_._2.size > 1).keys
+          println(s"[soak] duplicated names in the packages: ${dupes.mkString(", ")}")
+        }
+        // the same request in a fresh run of the same driver: per-run state, or the symbol table?
+        val again = SourceFile.virtual(uri, content + "\n// again")
+        driver.runUpTo(uri, again, Span(offset))
+        println(s"[soak] the same completion in a fresh run of this driver: ${labels(driver, again, offset)}")
+      org.junit.Assert.assertEquals(s"[$name seed=$seed step $step] completions at $offset after $what\n${log.takeRight(8).mkString("\n")}\ncontent:\n${content.substring(math.max(0, offset - 80), math.min(content.length, offset + 20))}", expected.mkString("\n"), obtained.mkString("\n"))
+      val t = touched(driver)
+      org.junit.Assert.assertTrue(s"[$name seed=$seed step $step] symbols still Touched after $what: ${t.mkString(", ")}", t.isEmpty)
+    for step <- 1 to steps do
+      val (content, offsets) = variants(variant)
+      val offset = offsets(rng.nextInt(offsets.size))
+      rng.nextInt(10) match
+        case 0 =>
+          variant = 1 - variant
+          check(step, "edit+complete", offsets(rng.nextInt(offsets.size)))
+        case 1 | 2 =>
+          val k = 1 + rng.nextInt(3)
+          var p = 0
+          val thrown =
+            try
+              driver.withCancelChecker(() => { if inTyperCheckpoint() then p += 1; p >= k }) {
+                driver.runUpTo(uri, SourceFile.virtual(uri, content), Span(offset))
+              }
+              false
+            catch case _: CancelledCompilation => true
+          polls += p
+          if thrown then cancelled += 1
+          log += s"$step cancel(k=$k)@$offset thrown=$thrown polls=$p run=${driver.runIdOf(uri)} typed=${driver.typedTopLevelCount(uri)}"
+          val t = touched(driver)
+          org.junit.Assert.assertTrue(s"[$name seed=$seed step $step] symbols still Touched after a cancellation: ${t.mkString(", ")}", t.isEmpty)
+          check(step, s"cancel(thrown=$thrown)+complete", if rng.nextBoolean() then offset else offsets(rng.nextInt(offsets.size)))
+        case _ =>
+          check(step, "complete", offset)
+    println(s"[soak $name seed=$seed] $steps steps, $fresh runs, $cancelled cancellations landed (${polls} polls), ${variants.head._2.size} points")
+    // A small file is mostly served from what is typed, so few attempts find typing to land in
+    org.junit.Assert.assertTrue(s"[$name seed=$seed] the cancellations must land: $cancelled of ${steps / 5} attempts", cancelled >= 1)
+
+  @Test def `objects-seed-1` = soak("objects", objectsFile(_), 1, 300)
+  @Test def `objects-seed-2` = soak("objects", objectsFile(_), 2, 300)
+  @Test def `shapes-seed-1` = soak("shapes", shapesFile, 1, 300)
+  /** Finding I18: at step 266 the completion in `val d = summon[Show[Int]].sh` of
+   *  a re-indexed `object Infer` answers nothing ("no implicit values were found
+   *  that match type shapes.Show[Int]") in the session's run, while the same
+   *  request in a fresh run of the same driver finds `show`. Per-run state left
+   *  by the earlier cancellations (steps 262 and 265); the givens' symbols are
+   *  complete and whole. Not reproduced since (the landings shift between JVMs);
+   *  the completers the cancellations unwind in this file (`class Plain`'s, the
+   *  `apply`s', `val d`'s) are replaced or poison the session now
+   *  (`InteractiveDriver.replaceUnwound`), see
+   *  `CompletionSessionSuite.cancel-inside-a-given-class-completer`.
+   */
+  @Test def `shapes-seed-2` = soak("shapes", shapesFile, 2, 300)
+  @Test def `shapes-seed-3` = soak("shapes", shapesFile, 3, 300)
