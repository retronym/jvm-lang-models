+            case d: untpd.TypeDef => best = t; bestName = s"${if d.mods.is(dotty.tools.dotc.core.Flags.Trait) then "trait" else "class"} ${d.name}"
+            case d: untpd.DefDef => best = t; bestName = s"def ${d.name}"
