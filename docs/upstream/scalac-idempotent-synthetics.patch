diff --git a/test/files/presentation/full-check-interleaved/Test.scala b/test/files/presentation/full-check-interleaved/Test.scala
new file mode 100644
index 0000000000..cafdff2191
--- /dev/null
+++ b/test/files/presentation/full-check-interleaved/Test.scala
@@ -0,0 +1,42 @@
+import java.util.concurrent.CountDownLatch
+import scala.tools.nsc.interactive.Global
+import scala.tools.nsc.interactive.tests.InteractiveTest
+
+// A type check of the whole unit (`askType`) is served while background type checking is still in `Before`.
+// Both its tree and the background's, which later `askLoadedTyped`s return, must have the synthetic
+// definitions of `L` and its companion.
+object Test extends InteractiveTest {
+  val reached, posted = new CountDownLatch(1)
+
+  override protected def createGlobal: Global = new Global(settings, compilerReporter) {
+    override def signalDone(context: Context, old: Tree, result: Tree): Unit = {
+      if (onCompilerThread && reached.getCount > 0 && interruptsEnabled && lockedCount == 0) {
+        reached.countDown()
+        posted.await()
+      }
+      super.signalDone(context, old, result)
+    }
+  }
+
+  override protected def runDefaultTests(): Unit = {
+    import compiler._
+    val src = sourceFiles.head
+    reached.await()
+    val typed = new Response[Tree]
+    askType(src, forceReload = false, typed)
+    posted.countDown()
+    val nested = typed.get.swap.toOption.get
+    while (compiler.isOutOfDate) Thread.sleep(10)          // the background type check finishes, and stores its tree
+    val loaded = new Response[Tree]
+    compiler.askLoadedTyped(src, loaded)
+    val tree = loaded.get.swap.toOption.get
+    println(unitOfFile(src.file).problems.mkString("\n"))
+    def show(label: String, t: Tree) = compiler.ask { () =>
+      for (Block(stats, _) <- t.collect { case b: Block => b }; impl <- stats.collect { case i: ImplDef => i })
+        println(s"$label ${impl.symbol}: " + impl.impl.body.collect { case d: DefDef if d.symbol.isSynthetic => d.name }.mkString(" "))
+    }
+    println(s"final tree is the nested one: ${nested eq tree}")
+    show("nested", nested)
+    show("final", tree)
+  }
+}
